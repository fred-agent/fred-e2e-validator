#!/usr/bin/env bash
# The local deployment imports the image from the generated list and uses
# the generated chart values to select that image.
set -Eeuo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
: "${K3D_APP_OUT:?run through make k3d-app in the deployment factory}"
repository=fred-e2e-tests

docker build --platform linux/amd64 --file "$root/deploy/Dockerfile" --tag "$repository:build" "$root"
# Docker's content id names the image, so a changed image always rolls out.
id="$(docker image inspect --format '{{.Id}}' "$repository:build")"
tag="k3d-${id:7:12}"
docker tag "$repository:build" "$repository:$tag"

printf '%s\n' "$repository:$tag" >"$K3D_APP_OUT/images.txt"
printf 'image:\n  repository: %s\n  tag: "%s"\n  pullPolicy: IfNotPresent\n' \
  "$repository" "$tag" >"$K3D_APP_OUT/images.yaml"
echo "Built $repository:$tag"
