# The keys of .env, which holds the synthetic accounts only; values are never
# committed. Account set 1 serves the first worker, and set 2, whose keys end
# in _2, the second.

# The username of admin, the platform administrator, account set 1.
ACCOUNT_ADMIN_USERNAME=
# The password of admin, the platform administrator, account set 1.
ACCOUNT_ADMIN_PASSWORD=
# The email of admin, the platform administrator, account set 1.
ACCOUNT_ADMIN_EMAIL=
# The username of member, the user who works in the configured test space, account set 1.
ACCOUNT_MEMBER_USERNAME=
# The password of member, the user who works in the configured test space, account set 1.
ACCOUNT_MEMBER_PASSWORD=
# The email of member, the user who works in the configured test space, account set 1.
ACCOUNT_MEMBER_EMAIL=
# The username of secondUser, a second user with no platform role, account set 1.
ACCOUNT_SECOND_USER_USERNAME=
# The password of secondUser, a second user with no platform role, account set 1.
ACCOUNT_SECOND_USER_PASSWORD=
# The email of secondUser, a second user with no platform role, account set 1.
ACCOUNT_SECOND_USER_EMAIL=
# The username of outsider, a user never added to any team, account set 1.
ACCOUNT_OUTSIDER_USERNAME=
# The password of outsider, a user never added to any team, account set 1.
ACCOUNT_OUTSIDER_PASSWORD=
# The email of outsider, a user never added to any team, account set 1.
ACCOUNT_OUTSIDER_EMAIL=

# The username of admin, the platform administrator, account set 2.
ACCOUNT_ADMIN_USERNAME_2=
# The password of admin, the platform administrator, account set 2.
ACCOUNT_ADMIN_PASSWORD_2=
# The email of admin, the platform administrator, account set 2.
ACCOUNT_ADMIN_EMAIL_2=
# The username of member, the user who works in the configured test space, account set 2.
ACCOUNT_MEMBER_USERNAME_2=
# The password of member, the user who works in the configured test space, account set 2.
ACCOUNT_MEMBER_PASSWORD_2=
# The email of member, the user who works in the configured test space, account set 2.
ACCOUNT_MEMBER_EMAIL_2=
# The username of secondUser, a second user with no platform role, account set 2.
ACCOUNT_SECOND_USER_USERNAME_2=
# The password of secondUser, a second user with no platform role, account set 2.
ACCOUNT_SECOND_USER_PASSWORD_2=
# The email of secondUser, a second user with no platform role, account set 2.
ACCOUNT_SECOND_USER_EMAIL_2=
# The username of outsider, a user never added to any team, account set 2.
ACCOUNT_OUTSIDER_USERNAME_2=
# The password of outsider, a user never added to any team, account set 2.
ACCOUNT_OUTSIDER_PASSWORD_2=
# The email of outsider, a user never added to any team, account set 2.
ACCOUNT_OUTSIDER_EMAIL_2=
